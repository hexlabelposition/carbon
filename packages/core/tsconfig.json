{
  "compilerOptions": {
    /* Language and environment: no DOM and no ambient types, the core must
       run in a Web Worker and in tests */
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": [],

    /* Modules */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    /* Emit */
    "noEmit": true,

    /* Type checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
