{
  "compilerOptions": {
    "target": "ES2022",
    /* No DOM and no ambient types: the core must run in a Web Worker and in tests */
    "lib": ["ES2022"],
    "types": [],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
