---
// A line of text where the parts in backticks are shown as code.
interface Props {
  text: string;
}

const parts = Astro.props.text.split("`");
---

{parts.map((part, i) =>
  i % 2 ? (
    <code class="rounded-sm border border-line bg-code px-1 font-mono text-[0.88em]">
      {part}
    </code>
  ) : (
    part
  ),
)}
