---
// A picture of the app, drawn in HTML: the file tree, a note and its
// backlinks. Not interactive.
const tree = [
  { name: "Projects", folder: true },
  { name: "Carbon roadmap", nested: true, current: true },
  { name: "Reading list", nested: true },
  { name: "Journal", folder: true },
  { name: "2026-11-26", nested: true },
  { name: "Ideas" },
];

const backlinks = [
  { from: "Ideas", before: "…keep it in the " },
  { from: "2026-11-26", before: "Moved two items to " },
];

const tasks = [
  { text: "Full-text search", done: true },
  { text: "Graph of notes", done: true },
  { text: "Android, next in line", done: false },
];

const heading = "text-xs font-semibold tracking-wide text-faint uppercase";
---

<div class="overflow-hidden rounded-xl border border-line bg-bg text-left shadow-window">
  <div class="flex gap-1.5 border-b border-line bg-panel px-3.5 py-3">
    <span class="size-2.75 rounded-full bg-line-strong"></span>
    <span class="size-2.75 rounded-full bg-line-strong"></span>
    <span class="size-2.75 rounded-full bg-line-strong"></span>
  </div>
  <div class="grid min-h-85 grid-cols-1 sm:grid-cols-[180px_1fr] lg:grid-cols-[200px_1fr_230px]">
    <aside class="hidden border-r border-line bg-panel px-3 py-4 text-sm sm:block">
      <div class:list={[heading, "mx-2 mb-2.5"]}>My vault</div>
      {tree.map((item) => (
        <div
          class:list={[
            "rounded-md px-2 py-0.75",
            item.nested && "pl-5.5",
            item.folder ? "font-medium text-fg" : "text-muted",
            item.current && "bg-selected text-fg",
          ]}
        >
          {item.name}
        </div>
      ))}
    </aside>

    <article class="px-6 py-6 sm:px-10 sm:py-7">
      <h2 class="mb-3.5 text-[28px] font-bold tracking-tight">
        Carbon roadmap
      </h2>
      <p class="mb-3.5">
        Everything starts as a plain note. Link it to
        <span class="wiki">Reading list</span> or to today’s
        <span class="wiki">2026-11-26</span>, and the link survives a rename.
      </p>
      <ul class="mb-3.5 space-y-1">
        {tasks.map(({ text, done }) => (
          <li
            class:list={[
              "flex items-center gap-3",
              done && "text-faint line-through",
            ]}
          >
            <span
              class:list={[
                "size-3.5 shrink-0 rounded-sm border-[1.5px]",
                done ? "border-transparent bg-solid" : "border-line-strong",
              ]}
            />
            {text}
          </li>
        ))}
      </ul>
      <p class="flex gap-1.5 text-sm">
        <span class="rounded-full bg-raise px-2.5 py-px text-muted">
          #planning
        </span>
        <span class="rounded-full bg-raise px-2.5 py-px text-muted">
          #carbon
        </span>
      </p>
    </article>

    <aside class="hidden border-l border-line bg-panel px-3 py-4 text-sm lg:block">
      <div class:list={[heading, "mx-2 mb-2.5"]}>Backlinks</div>
      {backlinks.map(({ from, before }) => (
        <div class="mb-1 flex flex-col gap-0.5 rounded-md p-2">
          <strong class="font-medium">{from}</strong>
          <span class="text-[13px] text-muted">
            {before}
            <mark class="rounded-sm bg-highlight px-0.5 text-inherit">
              Carbon roadmap
            </mark>
          </span>
        </div>
      ))}
    </aside>
  </div>
</div>

<style>
  .wiki {
    color: var(--cb-link);
    border-bottom: 1px solid color-mix(in srgb, var(--cb-link) 40%, transparent);
  }
</style>
