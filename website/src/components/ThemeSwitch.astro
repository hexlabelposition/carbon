---
// Light, dark or as the system is set, as in the settings of the app: the
// choice is `data-theme` on <html> (src/styles/tokens.css), kept in
// localStorage. The script in the layout sets it before the page is drawn.
import Icon, { type IconName } from "./Icon.astro";

const choices: { theme: string; label: string; icon: IconName }[] = [
  { theme: "light", label: "Light theme", icon: "sun" },
  { theme: "dark", label: "Dark theme", icon: "moon" },
  { theme: "system", label: "Theme of the system", icon: "monitor" },
];
---

<div
  role="group"
  aria-label="Theme"
  class="flex rounded-lg border border-line bg-panel p-0.5"
>
  {choices.map(({ theme, label, icon }) => (
    <button
      type="button"
      data-theme-choice={theme}
      aria-label={label}
      title={label}
      aria-pressed={theme === "system" ? "true" : "false"}
      class="flex size-7 cursor-pointer items-center justify-center rounded-md text-faint transition-colors hover:text-fg aria-pressed:bg-bg aria-pressed:text-fg aria-pressed:shadow-[0_0_0_1px_var(--cb-line-strong)]"
    >
      <Icon name={icon} class="size-4" />
    </button>
  ))}
</div>
