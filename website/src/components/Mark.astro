---
// The mark of the logo, as in the corner of the app (CarbonMark): its
// shades come from the tokens, so they follow the theme. With `wave` the
// light runs around the ring, as on the start screen of the app
// (src/features/brand/CarbonLogo.tsx).
interface Props {
  class?: string;
  wave?: boolean;
}

const { class: className, wave = false } = Astro.props;
const WAVE_SECONDS = 6;
const hexagon = "62,0 31,53.7 -31,53.7 -62,0 -31,-53.7 31,-53.7";
const cells = [
  { x: 0, y: -117, fill: "var(--cb-logo-top)", ring: 0 },
  { x: -101.3, y: -58.5, fill: "var(--cb-logo-upper)", ring: 5 },
  { x: 101.3, y: -58.5, fill: "var(--cb-logo-upper)", ring: 1 },
  { x: -101.3, y: 58.5, fill: "var(--cb-logo-lower)", ring: 4 },
  { x: 101.3, y: 58.5, fill: "var(--cb-logo-lower)", ring: 2 },
  { x: 0, y: 117, fill: "var(--cb-logo-bottom)", ring: 3 },
  { x: 0, y: 0, fill: "var(--cb-logo-center)" },
];

function style(fill: string, ring?: number): string {
  if (!wave || ring === undefined) return `fill: ${fill}`;
  const delay = (-(6 - ring) * WAVE_SECONDS) / 6;
  return `fill: ${fill}; animation-duration: ${WAVE_SECONDS}s; animation-delay: ${delay}s`;
}
---

<svg class={className} viewBox="-164 -171 328 342" aria-hidden="true">
  {cells.map(({ x, y, fill, ring }) => (
    <polygon
      points={hexagon}
      transform={`translate(${x},${y})`}
      class:list={[wave && ring !== undefined && "wave"]}
      style={style(fill, ring)}
    />
  ))}
</svg>

<style>
  @keyframes wave {
    0%,
    100% {
      fill: var(--cb-logo-wave-top);
    }
    16.667%,
    83.333% {
      fill: var(--cb-logo-wave-upper);
    }
    33.333%,
    66.667% {
      fill: var(--cb-logo-wave-lower);
    }
    50% {
      fill: var(--cb-logo-wave-bottom);
    }
  }

  .wave {
    animation-name: wave;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .wave {
      animation: none;
    }
  }
</style>
