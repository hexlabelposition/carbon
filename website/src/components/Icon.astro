---
// Icons drawn on 16 by 16 with lines, in the style of the app's toolbar
// (src/shells/desktop/toolbar-icons.tsx); files, graph and settings are
// copied from there.
const icons = {
  files:
    '<path d="M1.5 4.5A1.5 1.5 0 0 1 3 3h3l1.5 1.5H13a1.5 1.5 0 0 1 1.5 1.5v5.5A1.5 1.5 0 0 1 13 13H3a1.5 1.5 0 0 1-1.5-1.5z"/>',
  graph:
    '<circle cx="4" cy="4.5" r="2"/><circle cx="12" cy="6" r="2"/><circle cx="6.5" cy="12" r="2"/><path d="M5.95 4.95l4.1.6M10.6 7.45l-2.7 3.1M4.8 6.35l.95 3.8"/>',
  settings:
    '<path d="M2 4.5h2M7.5 4.5H14M2 11.5h6.5M12 11.5h2"/><circle cx="5.75" cy="4.5" r="1.75"/><circle cx="10.25" cy="11.5" r="1.75"/>',
  chevron: '<path d="M6.5 4.5L10 8l-3.5 3.5"/>',
  bolt: '<path d="M9 1.5L3 9h4.5L7 14.5 13 7H8.5z"/>',
  lock: '<rect x="3" y="7" width="10" height="7.5" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/>',
  eye: '<path d="M1.5 8S4 3.5 8 3.5 14.5 8 14.5 8 12 12.5 8 12.5 1.5 8 1.5 8z"/><circle cx="8" cy="8" r="2"/>',
  download: '<path d="M8 2v8.5M4.5 7L8 10.5 11.5 7M2.5 13.5h11"/>',
  github:
    '<path d="M6 13.5c-3 1-3-1.5-4.5-2M10 15v-2.2a2 2 0 0 0-.55-1.5c1.85-.2 3.8-.9 3.8-4.1A3.2 3.2 0 0 0 12.4 5a3 3 0 0 0-.05-2.2s-.7-.2-2.3.85a7.9 7.9 0 0 0-4.1 0C4.35 2.6 3.65 2.8 3.65 2.8A3 3 0 0 0 3.6 5a3.2 3.2 0 0 0-.85 2.2c0 3.2 1.95 3.9 3.8 4.1A2 2 0 0 0 6 12.8V15"/>',
  sun: '<circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.25M8 13.25v1.25M1.5 8h1.25M13.25 8h1.25M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9"/>',
  moon: '<path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7z"/>',
  monitor:
    '<rect x="1.5" y="2.5" width="13" height="9" rx="1.5"/><path d="M5.5 14h5M8 11.5V14"/>',
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;
---

<svg
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={icons[name]}
/>
