{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carbon",
  "version": "../package.json",
  "identifier": "io.github.hexlabelposition.carbon",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Carbon",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNjIwMEMyQ0NDNjY0QjAKUldTd1pNYk13Z0JpVDVBdldyVGdwVHFUQWZER1ozMThLazE1RStzc1BpUkRmcHhxN2ptZWE1eTAK",
      "endpoints": [
        "https://github.com/hexlabelposition/carbon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "category": "Productivity",
    "shortDescription": "Fast, local-first notes with links",
    "longDescription": "Carbon keeps notes as plain Markdown files in a folder of your own and links them with [[wiki links]]: live preview, backlinks, tags, full-text search and a quick switcher, fast on vaults of ten thousand notes.",
    "publisher": "Vladyslav Kudriashov",
    "copyright": "Copyright (c) 2026 Vladyslav Kudriashov",
    "license": "MIT",
    "homepage": "https://github.com/hexlabelposition/carbon",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "text"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Carbon"
      }
    }
  }
}
