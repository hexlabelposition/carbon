{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,

    /* A referenced project may not disable emit; nothing is emitted in practice,
       the typecheck script passes --noEmit */
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsc-node"
  },
  "include": ["vite.config.ts", "scripts"]
}
